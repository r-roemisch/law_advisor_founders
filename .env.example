# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# Protects admin features (refresh, dashboard). Use a long random string.
ADMIN_TOKEN=

# Daily update run (cron syntax). docker-compose defaults to 03:00.
# UPDATE_CRON=0 3 * * *

# Set to 1 to run without OpenRouter (no language model, sample Corpus).
# DEMO_MODE=0

# Defaults match docker-compose.yml for local development:
# DATABASE_URL=postgresql://flg:flg@localhost:5432/flg
# QDRANT_URL=http://localhost:6333
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
